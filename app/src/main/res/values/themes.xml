<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CarDockBar" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <!-- ★ v1.5.9：状态栏 / 导航栏也刷成页面底色。
             之前只设了 windowBackground，这两条用的是系统默认纯黑 #000，
             跟页面底色 #101216 有色差 → 上下看着像两条黑边。 -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/bg_page</item>
        <item name="android:navigationBarColor">@color/bg_page</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
