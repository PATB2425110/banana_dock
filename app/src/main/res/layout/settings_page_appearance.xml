<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardAppearance"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_appearance"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCorner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="圆角半径"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <SeekBar
        android:id="@+id/sbCorner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="20" />

    <TextView
        android:id="@+id/tvIconScale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="图标缩放"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <SeekBar
        android:id="@+id/sbIconScale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100" />

    <TextView
        android:id="@+id/tvTextScale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="文字缩放"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <SeekBar
        android:id="@+id/sbTextScale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/swSeparators"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="显示分组竖分隔线"
        android:textColor="@color/text_primary" />

</LinearLayout>
