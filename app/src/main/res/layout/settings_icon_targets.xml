<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="14dp"
    android:visibility="gone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_entries"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="留空 = 按内置候选包名自动尝试。包名 + Activity 最准。"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="③ 车机设置"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etSettingsPkg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_field"
        android:hint="包名（默认 com.geely.settings）"
        android:inputType="text"
        android:padding="8dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etSettingsCls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_field"
        android:hint="Activity 全类名（默认 com.geely.settings.GlySettingsActivity）"
        android:inputType="text"
        android:padding="8dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etSettingsAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_field"
        android:hint="或 action（可留空）"
        android:inputType="text"
        android:padding="8dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="⑩ 座椅设置"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etSeatPkg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_field"
        android:hint="包名"
        android:inputType="text"
        android:padding="8dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etSeatCls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_field"
        android:hint="Activity 全类名（可留空）"
        android:inputType="text"
        android:padding="8dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etSeatAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_field"
        android:hint="或 action（可留空）"
        android:inputType="text"
        android:padding="8dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="⑦ 空调风向 / 温度点击打开的面板"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/etAirPkg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_field"
        android:hint="包名（默认 com.geely.hvac，留空 = 点击改为循环切换风向）"
        android:inputType="text"
        android:padding="8dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etAirCls"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_field"
        android:hint="Activity 全类名（默认 com.geely.hvac.activity.GlyMainActivity）"
        android:inputType="text"
        android:padding="8dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="13sp" />


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="最近任务（返回桌面按钮双击打开）"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Dock 上「返回桌面」按钮双击时打开的最近任务（后台应用列表）App。"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/etRecentsPkg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_field"
        android:hint="包名（默认 com.geely.recents）"
        android:inputType="text"
        android:padding="8dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnApplyEntries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_primary"
        android:text="@string/btn_apply_entries"
        android:textColor="?attr/primaryButtonText" />
</LinearLayout>
