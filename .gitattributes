# 默认按 LF 存储，检出时按平台处理
* text=auto eol=lf

# Windows 脚本必须是 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew.bat text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.aar binary
*.so binary
*.dex binary
*.apk binary
*.keystore binary
*.jks binary
